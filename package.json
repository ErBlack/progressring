{
  "name": "progressring",
  "author": "ErBlack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pebble build",
    "shots": "python3 tools/shots.py",
    "publish": "pebble publish --pbw build/progressring.pbw",
    "version": "npm run build",
    "postversion": "git push && git push --tags && npm run publish"
  },
  "pebble": {
    "displayName": "Progressring",
    "uuid": "85976604-4bc2-4213-ad6d-294e63e96973",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "TEMP",
      "COND",
      "RISE",
      "SET",
      "PLACE",
      "TZ",
      "EVENTS"
    ],
    "resources": {
      "media": []
    },
    "capabilities": [
      "health",
      "location"
    ],
    "usesPermissions": [
      "Location",
      "Calendar"
    ]
  }
}
