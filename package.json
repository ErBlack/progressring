{
  "name": "progressring",
  "author": "ErBlack",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "build": "pebble build",
    "shots": "python3 tools/shots.py",
    "publish": "pebble publish --pbw build/progressring.pbw --release-notes \"$(git log --format='- %s' $(git describe --tags --abbrev=0 HEAD^)..HEAD^)\"",
    "version": "npm run build",
    "postversion": "git push && git push --tags && npm run publish"
  },
  "pebble": {
    "displayName": "Progressring",
    "uuid": "85976604-4bc2-4213-ad6d-294e63e96973",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "TEMP",
      "COND",
      "RISE",
      "SET",
      "PLACE",
      "TZ",
      "EVENTS",
      "THEME",
      "WEEK",
      "BATT_SRC",
      "PBATT"
    ],
    "resources": {
      "media": [
        {
          "type": "raw",
          "name": "EMOJI_18",
          "file": "fonts/EMOJI_18.pbf"
        }
      ]
    },
    "capabilities": [
      "configurable",
      "health",
      "location"
    ],
    "usesPermissions": [
      "Location",
      "Calendar"
    ]
  },
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  }
}
